# Production için en az 32 karakterli, rastgele ve ortama özel bir değer sağlayın.
# Gerçek secret değerini bu dosyaya veya Git'e yazmayın.
SECRET_KEY=
APP_ENV=development
ALGORITHM=HS256
# Varsayılan ayarı kullanarak SQLite ile çalışabilirsiniz. PostgreSQL tercih ediyorsanız aşağıdaki satırın
# başındaki # işaretini kaldırın ve bağlantı bilgilerini güncelleyin.
# DATABASE_URL=postgresql+psycopg2://postgres:postgres@db:5432/butce_takip
ACCESS_TOKEN_EXPIRE_MINUTES=4320
allowed_hosts=*
cors_origins=http://localhost:5173,http://127.0.0.1:5173,http://172.24.2.128:5173,http://<SUNUCU_IP>:5173
CORS_ALLOW_CREDENTIALS=false

# Teklif Yönetimi belgeleri container dışında kalıcı volume'da saklanır.
QUOTE_STORAGE_PATH=./data/quote_documents
QUOTE_DOCUMENT_MAX_BYTES=20971520

# Yalnız boş kullanıcı tablosundaki kontrollü ilk kurulum için true yapın.
# Production'da e-posta ve güçlü parola açıkça secret yönetimi üzerinden sağlanmalıdır.
# İlk admin oluşturulduktan sonra bu bayrağı tekrar false yapın.
ADMIN_BOOTSTRAP_ENABLED=false
DEFAULT_ADMIN_EMAIL=
DEFAULT_ADMIN_PASSWORD=
DEFAULT_ADMIN_FULL_NAME=Admin Kullanıcı
DEFAULT_ADMIN_ROLE=admin
